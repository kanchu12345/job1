rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Listings Collection
    match /listings/{listingId} {
      // Anyone can read published listings. Authenticated users can read all.
      allow read: if resource == null || resource.data.status == 'published' || request.auth != null;
      
      // Only authenticated users can create/update/delete
      allow write: if request.auth != null;
    }
    
    // Users Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      // Users can only write their own document
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
